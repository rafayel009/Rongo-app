<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8FF"
    android:orientation="vertical"
    android:padding="20dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Widget settings"
        android:fontFamily="sans-serif-medium"
        android:textColor="#1D1736"
        android:textSize="24sp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingBottom="14dp"
        android:text="Pick a note to pin to this widget, or leave it automatic."
        android:textColor="#6C6684"
        android:textSize="13sp" />
    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="24dp"
        android:text="No notes yet. Open Rongo, create a note, then add this widget again."
        android:textColor="#6C6684"
        android:textSize="14sp"
        android:visibility="gone" />
    <ListView
        android:id="@+id/note_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="12dp"
        android:divider="#22000000"
        android:dividerHeight="1dp" />
</LinearLayout>
